<idea-plugin>
    <extensions defaultExtensionNs="com.intellij">
        <!-- .vaultbridge.json открывается как JSON5: комментарии и висячие запятые законны.
             Только name + fileNames: добавляем имя к уже существующему типу JSON-плагина.
             С implementationClass это повторное объявление типа → модальный диалог конфликта плагинов на старте IDE. -->
        <fileType name="JSON5" fileNames=".vaultbridge.json"/>
    </extensions>
    <extensions defaultExtensionNs="JavaScript.JsonSchema">
        <ProviderFactory implementation="dev.anykeyguru.vaultbridge.config.json.VaultBridgeSchemaProviderFactory"/>
    </extensions>
</idea-plugin>
