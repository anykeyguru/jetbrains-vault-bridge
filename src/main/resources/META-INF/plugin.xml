<idea-plugin>
    <id>dev.anykeyguru.vaultbridge</id>
    <name>Vault Bridge</name>
    <vendor>anykeyguru</vendor>
    <!-- description и change-notes подставляются при сборке из docs/*.html -->

    <depends>com.intellij.modules.platform</depends>
    <depends optional="true" config-file="vaultbridge-json.xml">com.intellij.modules.json</depends>

    <extensions defaultExtensionNs="com.intellij">
        <projectConfigurable parentId="tools"
                             id="dev.anykeyguru.vaultbridge.settings"
                             displayName="Vault Bridge"
                             instance="dev.anykeyguru.vaultbridge.settings.VaultConfigurable"/>
        <postStartupActivity implementation="dev.anykeyguru.vaultbridge.startup.VaultStartup"/>
        <notificationGroup id="Vault Bridge" displayType="BALLOON"/>
        <!-- config + git sync -->
        <postStartupActivity implementation="dev.anykeyguru.vaultbridge.config.VaultConfigStartup"/>
        <statusBarWidgetFactory id="VaultBridge.Status"
                                implementation="dev.anykeyguru.vaultbridge.ui.VaultStatusBarWidgetFactory"/>
        <!-- toolwindows: backlinks, tags, graph -->
        <toolWindow id="Vault Backlinks" anchor="right" secondary="true" icon="/icons/tw-backlinks.svg"
                    factoryClass="dev.anykeyguru.vaultbridge.toolwindow.BacklinksToolWindowFactory"/>
        <toolWindow id="Vault Tags" anchor="left" secondary="true" icon="/icons/tw-tags.svg"
                    factoryClass="dev.anykeyguru.vaultbridge.toolwindow.TagsToolWindowFactory"/>
        <toolWindow id="Vault Graph" anchor="bottom" icon="/icons/tw-graph.svg"
                    factoryClass="dev.anykeyguru.vaultbridge.toolwindow.GraphToolWindowFactory"/>
        <!-- editor: wiki-links -->
        <completion.contributor language="any" order="first"
                                implementationClass="dev.anykeyguru.vaultbridge.editor.WikiLinkCompletionContributor"/>
        <completion.confidence language="any" order="first"
                               implementationClass="dev.anykeyguru.vaultbridge.editor.WikiLinkCompletionConfidence"/>
        <lookup.charFilter order="first" implementation="dev.anykeyguru.vaultbridge.editor.WikiLinkCharFilter"/>
        <typedHandler order="first" implementation="dev.anykeyguru.vaultbridge.editor.WikiLinkTypedHandler"/>
        <codeInsight.lineMarkerProvider language=""
                                        implementationClass="dev.anykeyguru.vaultbridge.editor.WikiLinkLineMarkerProvider"/>
        <gotoDeclarationHandler implementation="dev.anykeyguru.vaultbridge.editor.WikiLinkGotoDeclarationHandler"/>
        <annotator language="" implementationClass="dev.anykeyguru.vaultbridge.editor.WikiLinkAnnotator"/>
        <!-- link check + missing status -->
        <toolWindow id="Vault Link Check" anchor="bottom" icon="/icons/action-diagnostics.svg"
                    factoryClass="dev.anykeyguru.vaultbridge.check.LinkCheckToolWindowFactory"/>
    </extensions>

    <actions>
        <group id="VaultBridge.Menu" text="Vault Bridge" popup="true" icon="/icons/vault.svg">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <action id="VaultBridge.Reindex"
                    class="dev.anykeyguru.vaultbridge.actions.ReindexVaultAction"
                    text="Re-index Vault"
                    description="Rescan all notes in the Obsidian vault"/>
            <!-- actions: search, daily, new, diagnostics -->
            <action id="VaultBridge.Search"
                    class="dev.anykeyguru.vaultbridge.actions.SearchVaultAction"
                    text="Search Vault…"
                    description="Find notes by title, alias, tag, path or content"
                    icon="/icons/action-search.svg"/>
            <action id="VaultBridge.DailyNote"
                    class="dev.anykeyguru.vaultbridge.actions.OpenDailyNoteAction"
                    text="Open Daily Note"
                    description="Open or create today's daily note using Obsidian's Daily notes settings"
                    icon="/icons/action-daily.svg"/>
            <action id="VaultBridge.NewNote"
                    class="dev.anykeyguru.vaultbridge.actions.NewNoteAction"
                    text="New Note…"
                    description="Create a note in the vault (use / for subfolders)"
                    icon="/icons/action-new-note.svg"/>
            <action id="VaultBridge.Diagnostics"
                    class="dev.anykeyguru.vaultbridge.actions.VaultDiagnosticsAction"
                    text="Vault Diagnostics"
                    description="Show vault statistics, unresolved links and duplicate note names"
                    icon="/icons/action-diagnostics.svg"/>
            <!-- link check + missing status -->
            <action id="VaultBridge.CheckLinks"
                    class="dev.anykeyguru.vaultbridge.check.CheckNoteLinksAction"
                    text="Check Note Links in Project"
                    description="Find [[links]] in project files that point to missing notes or headings"/>
            <!-- config + git sync -->
            <action id="VaultBridge.CreateConfig"
                    class="dev.anykeyguru.vaultbridge.config.CreateConfigAction"
                    text="Create .vaultbridge.json"
                    description="Save the vault path and git auto-commit settings to .vaultbridge.json in the project root"/>
            <action id="VaultBridge.CommitNow"
                    class="dev.anykeyguru.vaultbridge.config.CommitVaultNowAction"
                    text="Commit Vault Now"
                    description="Commit vault changes to its git repository now (and push, if enabled in .vaultbridge.json)"/>
        </group>
    </actions>
</idea-plugin>
